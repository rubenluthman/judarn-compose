#!/usr/bin/env bash
set -euo pipefail

COMMIT_MSG_FILE="$1"

# Extract first non-empty, non-comment line
FIRST_LINE=$(grep -v '^#' "$COMMIT_MSG_FILE" | grep -v '^[[:space:]]*$' | head -n 1 || true)

if [ -z "$FIRST_LINE" ]; then
    echo "❌ ERROR: Commit message cannot be empty." >&2
    exit 1
fi

# Allow automatic git merge commits
if [[ "$FIRST_LINE" =~ ^Merge[[:space:]] ]]; then
    exit 0
fi

# Allow revert commits generated by git revert
if [[ "$FIRST_LINE" =~ ^Revert[[:space:]] ]]; then
    exit 0
fi

# Conventional Commits format:
# <type>(<optional-scope>)<!>: <description>
PATTERN="^(feat|fix|refactor|perf|test|docs|chore|ci|build)(\([a-zA-Z0-9_/-]+\))?!?: .+$"

if ! [[ "$FIRST_LINE" =~ $PATTERN ]]; then
    echo "❌ ERROR: Commit message does not conform to Conventional Commits standard!" >&2
    echo "   Received: $FIRST_LINE" >&2
    echo "   Format:   <type>(<scope>): <subject>" >&2
    echo "   Types:    feat, fix, refactor, perf, test, docs, chore, ci, build" >&2
    echo "   Example:  feat(auth): add biometric unlock support" >&2
    exit 1
fi

# 50-character subject warning/check
SUBJECT_LEN=${#FIRST_LINE}
if [ "$SUBJECT_LEN" -gt 72 ]; then
    echo "❌ ERROR: Commit subject line exceeds 72 characters ($SUBJECT_LEN chars)." >&2
    echo "   Keep the summary concise and place details in the message body." >&2
    exit 1
fi

exit 0
